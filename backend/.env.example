# Local PostgreSQL database used by Prisma. Do not commit a real .env file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spendsmart?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Use a generated 32+ character value in production. Never commit the actual secret.
AUTH_SECRET="replace-with-a-long-random-secret"
# MongoDB is used only for user preferences and activity logs.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="spendsmart"
# Background interval for materializing due recurring transaction rules.
RECURRENCE_INTERVAL_MINUTES=60
